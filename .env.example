DATABASE_URL="postgresql://user:password@host:5432/morso?schema=public"
# Direct (non-pooled) connection string, used only by `prisma migrate deploy`
# for its advisory lock. On Neon this is the "-unpooled"/no-pgbouncer
# variant (Neon's Vercel integration provisions it as DATABASE_URL_UNPOOLED
# automatically). For a local, non-pooled Postgres instance this can just
# be the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/morso?schema=public"
AUTH_SECRET="generate with: openssl rand -base64 32"

# Base URL used to build links in emails (e.g. password reset links).
APP_URL="http://localhost:3000"

# Resend (https://resend.com) - used to send password reset emails.
# Without RESEND_API_KEY set, reset links are logged to the server console
# instead of emailed, so local dev still works without a Resend account.
RESEND_API_KEY=""
EMAIL_FROM="Morso <onboarding@resend.dev>"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple "Sign in with Apple" (https://developer.apple.com/account/resources/identifiers)
# AUTH_APPLE_ID = your Services ID. AUTH_APPLE_SECRET = the .p8 private key
# contents (NextAuth signs the JWT client_secret from this at request time).
# Return URL: <APP_URL>/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# PostHog (https://posthog.com) - product analytics. Without
# NEXT_PUBLIC_POSTHOG_KEY set, every trackEvent() call in src/lib/analytics.ts
# is a no-op and nothing is sent anywhere.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Sentry (https://sentry.io) - error monitoring. Without SENTRY_DSN set,
# src/instrumentation.ts never calls Sentry.init() and nothing is reported.
# NEXT_PUBLIC_SENTRY_DSN is the client-side equivalent (needs the
# NEXT_PUBLIC_ prefix to reach the browser bundle) - usually the same DSN.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
